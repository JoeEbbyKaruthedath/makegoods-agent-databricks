# Local development: copy to agent_app/.env and fill in.
# The deployed app gets these from resources/makegoods_agent.app.yml instead.
DATABRICKS_CONFIG_PROFILE=<your-cli-profile>
MLFLOW_TRACKING_URI=databricks
MLFLOW_REGISTRY_URI=databricks-uc
MLFLOW_EXPERIMENT_ID=<experiment-id-from-setup_experiment.py>
MLFLOW_TRACING_SQL_WAREHOUSE_ID=<your-sql-warehouse-id>
MLFLOW_DISABLE_AGENT_HINT=1
# local runs use their own Lakebase branch so the deployed app's service principal owns its schemas
LAKEBASE_AUTOSCALING_ENDPOINT=projects/makegoods/branches/dev-local/endpoints/primary
MG_LLM_ENDPOINT=databricks-claude-sonnet-5-5
MG_WAREHOUSE_ID=<your-sql-warehouse-id>
MG_GENIE_SPACE_ID=<genie-space-id>
# set to true only if the MLflow Prompt Registry is enabled in your workspace (then run scripts/register_prompts.py)
MG_USE_PROMPT_REGISTRY=false
